{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yet-another-player",
  "version": "0.0.0",
  "identifier": "com.bad.yet-another-player",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yet-another-player",
        "width": 1800,
        "height": 1000,
        "backgroundColor": "#050506"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://github.com https://*.githubusercontent.com; img-src 'self' data: blob: https:; media-src asset: http://asset.localhost",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/videos/*.mp4"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0NzdBMkIzODIwODdFMUUKUldRZWZnaUNzNkozSkdUSG5CTjlDNWVrYlZ6SklIdFUvaDlhNTFxaXRDdm93dnN4TEFuMmtKMjcK",
      "endpoints": [
        "https://github.com/BADtochka/yet-another-player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
